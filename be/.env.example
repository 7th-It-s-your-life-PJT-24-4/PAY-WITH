# Copy this file to .env before running Docker Compose locally.
MYSQL_DATABASE=paywith
MYSQL_USER=paywith
MYSQL_PASSWORD=paywith
MYSQL_ROOT_PASSWORD=root

DB_URL=jdbc:mysql://mysql:3306/paywith?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=paywith
DB_PASSWORD=paywith

REDIS_HOST=redis
REDIS_PORT=6379
TZ=Asia/Seoul
JWT_SECRET=local-development-secret-key-change-this-value-please-123456
SPRING_PROFILES_ACTIVE=local

FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/etc/paywith/firebase-service-account.json

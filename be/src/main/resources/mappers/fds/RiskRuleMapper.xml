<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.paywith.fds.mapper.RiskRuleMapper">
  <resultMap id="RiskRuleResultMap" type="com.paywith.fds.domain.RiskRule">
    <id property="ruleId" column="rule_id" />
    <result property="ruleCode" column="rule_code" />
    <result property="description" column="description" />
    <result property="score" column="score" />
    <result property="active" column="is_active" />
  </resultMap>

  <select id="findAllActive" resultMap="RiskRuleResultMap">
    SELECT rule_id, rule_code, description, score, is_active
    FROM risk_rules
    WHERE is_active = TRUE
  </select>
</mapper>

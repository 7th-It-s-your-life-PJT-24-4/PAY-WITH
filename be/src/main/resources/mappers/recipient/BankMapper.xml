<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.paywith.recipient.mapper.BankMapper">

    <select id="findBankName" resultType="String">
        SELECT bank_name FROM banks WHERE bank_code = #{bankCode}
    </select>

</mapper>
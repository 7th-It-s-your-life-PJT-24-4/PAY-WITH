<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.paywith.wallet.mapper.WalletMapper">

    <select id="findWalletByUserIdForUpdate" parameterType="Long"
            resultType="com.paywith.wallet.domain.Wallet">
        SELECT
        wallet_id, user_id, balance, status, created_at, updated_at
        FROM wallets
        WHERE user_id = #{userId}
        FOR UPDATE
    </select>

    <update id="increaseBalance">
        UPDATE wallets
        SET balance = balance + #{amount},
        updated_at = NOW()
        WHERE wallet_id = #{walletId}
    </update>

    <insert id="insert" parameterType="com.paywith.wallet.domain.Wallet"
            useGeneratedKeys="true" keyProperty="walletId" keyColumn="wallet_id">
        INSERT INTO wallets (user_id)
        VALUES (#{userId})
    </insert>

</mapper>
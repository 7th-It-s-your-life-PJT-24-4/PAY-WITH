<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.paywith.bank.mapper.BankFilterMapper">

    <resultMap id="BankResultMap" type="com.paywith.bank.domain.Bank">
        <id     property="bankCode" column="bank_code" />
        <result property="bankName" column="bank_name" />
        <result property="active"   column="is_active" />
    </resultMap>

    <select id="findAllActive" resultMap="BankResultMap">
        SELECT bank_code, bank_name, is_active FROM banks WHERE is_active = TRUE
    </select>

    <select id="existsActivePairing" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM guard_senior
            WHERE senior_id = #{wardId}
            AND status = 'ACTIVE'
        )
    </select>

</mapper>

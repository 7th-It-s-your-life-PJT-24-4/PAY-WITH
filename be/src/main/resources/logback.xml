<?xml version="1.0" encoding="UTF-8"?>
<!--
  이 파일이 생기기 전까지는 logback 기본 설정(root=DEBUG, 콘솔)으로 돌았다. Sentry 로 ERROR 를
  올리려면 appender 를 걸 설정 파일이 필요해 추가한 것이라, 출력 자체는 기존과 같게 맞춘다.

  root 만 INFO 로 낮췄다. 스프링·Hikari·Firebase 의 DEBUG 로그를 끄는 것이고, 우리 코드(com.paywith)
  는 그대로 DEBUG 다. MyBatis 는 매퍼 인터페이스 이름으로 SQL 을 찍으므로 이 설정에서도 로컬에서
  쿼리가 그대로 보인다.

  다만 그 SQL 로그에는 바인딩된 계좌번호가 평문으로 남는다. 배포 서버에서 조용히 만들려면
  deploy/.env 에 APP_LOG_LEVEL=INFO 를 넣으면 된다(컨테이너로 전달됨).
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      DSN 이 없으면 SDK 가 비활성 상태로 남아 이 appender 는 아무것도 보내지 않는다.
      로컬·테스트에서 별도 설정이 필요 없는 이유다.

      ERROR 만 이슈로 올린다. WARN 까지 열면 재시도·fail-open 경고까지 이슈가 되어, 정작
      봐야 할 것이 묻힌다. INFO 이상은 이슈 직전 흐름을 보여 주는 브레드크럼으로만 붙는다
      (전송 직전 SentryEventMasker 가 값을 가린다).
    -->
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <minimumEventLevel>ERROR</minimumEventLevel>
        <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SENTRY"/>
    </root>

    <logger name="com.paywith" level="${APP_LOG_LEVEL:-DEBUG}"/>

    <!--
      목 SMS 발송기는 인증번호를 로그로 흘려보내는 것이 존재 이유라, 콘솔에는 그대로 남겨야
      데모가 된다. 다만 그 줄이 Sentry 브레드크럼으로 따라 올라가면 인증번호가 외부 서비스에
      남는다(전화번호는 SentryEventMasker 가 가리지만 6자리 코드는 자릿수 규칙에 걸리지 않는다).
      additivity=false 로 root 의 SENTRY appender 를 상속하지 않게 해 콘솔로만 보낸다.

      실제 SMS 프로바이더를 붙여 MockSmsSender 를 걷어낼 때 이 설정도 같이 지운다.
    -->
    <logger name="com.paywith.auth.service.sms.MockSmsSender" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

</configuration>

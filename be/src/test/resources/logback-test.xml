<?xml version="1.0" encoding="UTF-8"?>
<!--
  테스트는 logback-test.xml 을 logback.xml 보다 먼저 집는다. Sentry appender 를 빼 두는 자리다.

  DSN 이 없으면 어차피 전송되지 않지만, 테스트가 우연히 환경변수를 물고 실제 이슈를 만드는 일은
  없어야 한다. CI 러너에 SENTRY_DSN 이 있는 상황을 가정한 안전장치다.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>

# 실제 값은 이 파일이 아니라 deploy/.env 에 넣는다. .env 는 gitignore 대상이다.
# RDS 엔드포인트. 포트(3306)는 compose 에서 붙이므로 호스트만 적는다.
RDS_ENDPOINT=your-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
MYSQL_DATABASE=paywith
MYSQL_USER=paywith
MYSQL_PASSWORD=change-this-mysql-password
JWT_SECRET=change-this-to-a-long-random-jwt-secret
PAIRING_INVITE_BASE_URL=https://paywith.site/ward/pairing

# 컨테이너 이미지. 비워 두면 compose 가 ../be, ../fe 를 직접 빌드한다(수동 배포용).
# CI 배포는 이 값을 셸 환경변수로 덮어써 GHCR 이미지를 커밋 SHA 태그로 띄우므로,
# .env 에 적어 둘 필요는 없다. 특정 버전으로 롤백할 때만 임시로 지정한다.
# APP_IMAGE=ghcr.io/7th-it-s-your-life-pjt-24-4/pay-with/pay-with-api:<커밋 SHA>
# WEB_IMAGE=ghcr.io/7th-it-s-your-life-pjt-24-4/pay-with/pay-with-web:<커밋 SHA>
